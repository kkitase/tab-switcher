{
  "manifest_version": 3,
  "name": "Tab Switcher",
  "version": "1.0.0",
  "description": "Option+Q で、Chrome のタブを最近使った順の一覧から切り替える",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tab Switcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "switch": {
      "suggested_key": { "default": "Alt+Q", "mac": "Alt+Q" },
      "description": "最近使った順にタブを切り替える"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["switcher.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
